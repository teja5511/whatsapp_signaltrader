# ==============================================================================
# Monorepo Workspace Git Ignore
# ==============================================================================

# Node.js & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
*.log

# Build Outputs & Bundles
dist/
build/
out/
.next/
.turbo/

# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.coverage.*
*.egg-info/
.ruff_cache/
.mypy_cache/

# Databases, WAL Journals, and Backups
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/
data/

# WhatsApp Worker Runtime State & Sessions
.node-persist/
**/node-persist/
**/storage/
**/sessions/
**/quarantine/
**/spool/
**/locks/

# Temporary Scratch Files & Output Artifacts
scratch/
**/scratch/
Outputs/

# Tauri & Rust Build Outputs
src-tauri/target/
src-tauri/Cargo.lock

# Environment Files (Keep .env.example)
.env
.env.*
!.env.example

# This repo installs with pnpm. Ignore npm lockfiles if a tool creates them.
package-lock.json

# Local knowledge-graph output
graphify-out/

# IDE, OS, & System Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
