{
  "name": "@whatsapp-bot/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp XAUUSD Signal Trading Bot Monorepo",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "validate": "powershell -ExecutionPolicy Bypass -File ./scripts/validate.ps1",
    "test": "pnpm --recursive run test",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "orchestration:test": "pytest apps/trading-service/tests/orchestration",
    "orchestration:contracts": "pnpm --filter @whatsapp-bot/shared-contracts build",
    "orchestration:benchmark": "pytest -s apps/trading-service/tests/orchestration/test_orchestration_benchmarks.py",
    "orchestration:migrations": "python apps/trading-service/alembic/run.py upgrade head",
    "events:test": "pytest apps/trading-service/tests/events",
    "events:benchmark": "pytest -s apps/trading-service/tests/orchestration/test_orchestration_benchmarks.py",
    "e2e:fake": "pytest apps/trading-service/tests/test_e2e_fake.py"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
