{
  "name": "@whatsapp-bot/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp XAUUSD Signal Trading Bot Monorepo",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "validate": "powershell -ExecutionPolicy Bypass -File ./scripts/validate.ps1",
    "test": "pnpm --recursive run test",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive run typecheck",
    "desktop:dev": "pnpm --filter @whatsapp-bot/desktop dev",
    "desktop:build": "pnpm --filter @whatsapp-bot/desktop build",
    "desktop:test": "pnpm --filter @whatsapp-bot/desktop test",
    "desktop:test:e2e": "pnpm --filter @whatsapp-bot/desktop test:e2e",
    "desktop:lint": "pnpm --filter @whatsapp-bot/desktop lint",
    "desktop:typecheck": "pnpm --filter @whatsapp-bot/desktop typecheck",
    "desktop:tauri:dev": "pnpm --filter @whatsapp-bot/desktop tauri dev",
    "desktop:tauri:build": "pnpm --filter @whatsapp-bot/desktop tauri build",
    "desktop:visual": "pnpm --filter @whatsapp-bot/desktop test:watch",
    "whatsapp:test": "pnpm --filter @whatsapp-bot/whatsapp-worker test",
    "whatsapp:contracts": "pnpm --filter @whatsapp-bot/shared-contracts build",
    "orchestration:test": "pytest apps/trading-service/tests/orchestration",
    "orchestration:contracts": "pnpm --filter @whatsapp-bot/shared-contracts build",
    "orchestration:benchmark": "pytest -s apps/trading-service/tests/orchestration/test_orchestration_benchmarks.py",
    "orchestration:migrations": "python apps/trading-service/alembic/run.py upgrade head",
    "events:test": "pytest apps/trading-service/tests/events",
    "events:benchmark": "pytest -s apps/trading-service/tests/orchestration/test_orchestration_benchmarks.py",
    "e2e:fake": "pytest apps/trading-service/tests/test_e2e_fake.py",
    "reconciliation:test": "pytest apps/trading-service/tests/reconciliation",
    "recovery:test": "pytest apps/trading-service/tests/recovery",
    "reliability:test": "pytest apps/trading-service/tests/reliability",
    "security:audit": "pnpm audit",
    "release:validate": "powershell -ExecutionPolicy Bypass -File ./scripts/validate.ps1",
    "release:build": "pnpm desktop:tauri:build"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
