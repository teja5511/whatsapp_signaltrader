# ==============================================================================
# WhatsApp MT5 Trading Bot - Environment Configuration Template
# Copy this file to '.env' and fill in your actual demo credentials & settings.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GITHUB.
# ==============================================================================

# MetaTrader 5 Account Credentials (DEMO ONLY)
MT5_ADAPTER_MODE=real
MT5_LOGIN=12345678
MT5_PASSWORD=YourDemoAccountPassword
MT5_SERVER=Exness-MT5Trial6
MT5_TERMINAL_PATH=
MT5_CLOSE_ALL_ENABLED=true

# Approved WhatsApp Group & Admin Security Restrictions
APPROVED_GROUP_JID=120363000000000000@g.us
APPROVED_ADMIN_JID=1234567890@s.whatsapp.net

# WhatsApp Client Adapter Mode ("real" for Baileys direct web client, "fake" for dry run)
WHATSAPP_ADAPTER_MODE=real

# Service API Authentication & Network Config
LOCAL_API_TOKEN=your-secure-local-api-token-here
PORT=8000
HOST=127.0.0.1
